<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">whatsapp.template.list</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates (HSM)">
                <field name="name"/>
                <field name="account_id"/>
                <field name="model_id"/>
                <field name="language"/>
                <field name="header_type"/>
                <field name="escalation_hours" string="Escalation (h)" optional="show"/>
                <field name="button_count" string="Buttons" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="Official Meta Template (HSM)">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Meta Template Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. send_quotation_v1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Main Configuration">
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="language"/>
                            <field name="header_type"/>
                            <field name="active"/>
                        </group>
                        <group string="Dynamic Mapping and Escalation">
                            <label for="escalation_hours" string="Call Escalation"/>
                            <div class="o_row">
                                <field name="escalation_hours" class="oe_inline" style="width: 70px;"/>
                                <span>hours</span>
                                <span class="text-muted ms-2">(0 = use company global)</span>
                            </div>
                            <field name="variable_mapping" placeholder="partner_id.name, name, amount_total"/>
                            <div class="text-muted" colspan="2">
                                Enter comma-separated field paths to substitute variables {{1}}, {{2}}, {{3}} in sequential order.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message Body">
                            <field name="body" 
                                   placeholder="Hello {{1}}, we share your document {{2}} for a total of {{3}}..." 
                                   widget="text" 
                                   style="width: 100%; min-height: 150px;"/>
                        </page>
                        <page string="Interactive Buttons" name="buttons">
                            <field name="button_ids">
                                <list editable="bottom" string="Template Buttons">
                                    <field name="sequence" widget="handle"/>
                                    <field name="button_type"/>
                                    <field name="name" string="Button Label"/>
                                    <field name="phone_number" 
                                           invisible="button_type != 'phone_number'" 
                                           required="button_type == 'phone_number'" 
                                           placeholder="e.g. +16505551234"/>
                                    <field name="url_type" 
                                           invisible="button_type != 'url'" 
                                           required="button_type == 'url'"/>
                                    <field name="url" 
                                           invisible="button_type != 'url'" 
                                           required="button_type == 'url'" 
                                           placeholder="e.g. https://company.com/pay/{{1}}"/>
                                    <field name="url_field_path" 
                                           invisible="button_type != 'url' or url_type != 'dynamic'" 
                                           placeholder="e.g. name"/>
                                    <field name="quick_reply_payload" 
                                           invisible="button_type != 'quick_reply'" 
                                           placeholder="e.g. CONFIRM_PAYMENT"/>
                                 </list>
                            </field>
                            <div class="text-muted mt-2">
                                <small>
                                    <strong>Official Meta Cloud API specifications:</strong>
                                    <ul>
                                        <li><strong>Call Phone (PHONE_NUMBER):</strong> Opens the customer's phone dialer (max. 1 button). Does not accept variables.</li>
                                        <li><strong>Quick Reply (QUICK_REPLY):</strong> Sends a predefined response when clicked and reactivates the 24-hour window (max. 3 buttons).</li>
                                        <li><strong>Website (URL):</strong> Opens a web page (max. 2 buttons). For dynamic URLs, configure the field path that will replace the path variable.</li>
                                    </ul>
                                </small>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">Official Templates (HSM)</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register approved Meta HSM templates to initiate conversations outside the 24-hour window.
            </p>
        </field>
    </record>
</odoo>
