<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_whatsapp_account_tree" model="ir.ui.view">
        <field name="name">whatsapp.account.list</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Accounts">
                <field name="name"/>
                <field name="phone_number_id"/>
                <field name="waba_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_whatsapp_account_form" model="ir.ui.view">
        <field name="name">whatsapp.account.form</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Cloud API Account">
                <header>
                    <button name="action_test_connection" 
                            string="Test Connection" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-plug"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Main WhatsApp - Sales"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Meta Identifiers">
                            <field name="phone_number_id" placeholder="e.g. 104589214785236"/>
                            <field name="waba_id" placeholder="e.g. 195487215487965"/>
                            <field name="api_version"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Security and Credentials">
                            <field name="graph_api_token" password="True"/>
                            <field name="app_secret" password="True"/>
                            <field name="webhook_verify_token"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Webhook Instructions">
                            <div class="alert alert-info" role="alert">
                                <h6><strong>Configuration in Meta Developers Portal:</strong></h6>
                                <p>1. Callback URL: <code>https://YOUR_DOMAIN/whatsapp/webhook</code></p>
                                <p>2. Verification Token: Enter the exact value configured in the <strong>Webhook Verify Token</strong> field.</p>
                                <p>3. In the Webhook subscription fields, subscribe to the events: <code>messages</code>.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_whatsapp_account" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">whatsapp.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp Cloud API account linked to Meta.
            </p>
        </field>
    </record>
</odoo>
