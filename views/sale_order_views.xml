<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" 
                        string="Send via WhatsApp" 
                        type="object" 
                        class="btn-primary" 
                        icon="fa-whatsapp"
                        invisible="state == 'cancel'"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="whatsapp_health_state" widget="badge"
                       decoration-success="whatsapp_health_state == 'active'"
                       decoration-warning="whatsapp_health_state == 'expired'"
                       decoration-danger="whatsapp_health_state == 'cold'"
                       decoration-muted="whatsapp_health_state == 'none'"
                       invisible="not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
