<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.inherit.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" 
                        string="Enviar por WhatsApp" 
                        type="object" 
                        class="btn-primary" 
                        icon="fa-whatsapp"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
