<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_composer_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.composer.wizard.form</field>
        <field name="model">whatsapp.composer.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="is_window_open" invisible="1"/>

                <div class="alert alert-info d-flex align-items-center mb-3" role="alert" invisible="not is_window_open">
                    <i class="fa fa-info-circle fa-2x me-2" title="Information"/>
                    <div>
                        <strong>24-Hour Window Active:</strong> The customer has recently interacted. You may write a freeform message or select an HSM template.
                    </div>
                </div>

                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert" invisible="is_window_open">
                    <i class="fa fa-exclamation-triangle fa-2x me-2" title="Warning"/>
                    <div>
                        <strong>24-Hour Window Inactive:</strong> Meta requires sending an approved Official HSM Template to initiate a conversation.
                    </div>
                </div>

                <group>
                    <group>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="phone" placeholder="+5215512345678"/>
                    </group>
                    <group>
                        <field name="message_mode" widget="radio" readonly="not is_window_open"/>
                        <field name="template_id" 
                               invisible="message_mode != 'template'" 
                               required="message_mode == 'template'"
                               options="{'no_create': True}"/>
                    </group>
                </group>

                <notebook>
                    <page string="Message Content">
                        <field name="body" 
                               placeholder="Compose your message or select a template to load dynamic content..." 
                               widget="text" 
                               style="width: 100%; min-height: 120px;"/>
                        <field name="has_buttons" invisible="1"/>
                        <field name="button_summary" invisible="1"/>
                        <div class="mt-3 p-3 bg-light border rounded" invisible="not has_buttons or message_mode != 'template'">
                            <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                <div class="d-flex align-items-center text-muted fw-bold">
                                    <i class="fa fa-mouse-pointer me-2 text-primary"/>
                                    <span>Interactive Template Buttons (Meta WhatsApp)</span>
                                </div>
                                <span class="badge bg-secondary text-white">Preview</span>
                            </div>
                            <field name="button_preview_html" widget="html" nolabel="1" readonly="1" options="{'cssReadonly': True}"/>
                        </div>
                    </page>
                    <page string="Official PDF Attachment">
                        <group>
                            <group>
                                <field name="attach_pdf"/>
                                <field name="pdf_filename" invisible="not attach_pdf"/>
                            </group>
                            <group>
                                <field name="report_action_id" invisible="not attach_pdf" options="{'no_create': True}"/>
                                <field name="caption" invisible="not attach_pdf" placeholder="e.g. 📄 Factura: INV/2026/0001 | Total: $1,500.00 | Vence: 30/10/2026"/>
                            </group>
                        </group>
                        <div invisible="not attach_pdf" class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-muted">
                                    <i class="fa fa-file-text-o me-1"/> Interactive Document Preview
                                </span>
                                <button name="action_view_pdf_fullscreen" 
                                        type="object" 
                                        string="Open Fullscreen PDF" 
                                        class="btn btn-sm btn-outline-primary" 
                                        icon="fa-external-link"/>
                            </div>
                            <field name="pdf_preview_html" widget="html" nolabel="1" readonly="1" options="{'cssReadonly': True}"/>
                        </div>
                    </page>
                </notebook>

                <footer>
                    <button string="Send via WhatsApp" name="action_send_whatsapp" type="object" class="btn-primary" icon="fa-whatsapp"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
