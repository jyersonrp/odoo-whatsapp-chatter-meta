<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_whatsapp_account_tree" model="ir.ui.view">
        <field name="name">whatsapp.account.list</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <list string="Cuentas de WhatsApp">
                <field name="name"/>
                <field name="phone_number_id"/>
                <field name="waba_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_whatsapp_account_form" model="ir.ui.view">
        <field name="name">whatsapp.account.form</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta de WhatsApp Cloud API">
                <header>
                    <button name="action_test_connection" 
                            string="Probar Conexión" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-plug"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ej. WhatsApp Principal - Ventas"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identificadores de Meta">
                            <field name="phone_number_id" placeholder="Ej. 104589214785236"/>
                            <field name="waba_id" placeholder="Ej. 195487215487965"/>
                            <field name="api_version"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Seguridad y Credenciales">
                            <field name="graph_api_token" password="True"/>
                            <field name="app_secret" password="True"/>
                            <field name="webhook_verify_token"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instrucciones del Webhook">
                            <div class="alert alert-info" role="alert">
                                <h6><strong>Configuración en Meta Developers Portal:</strong></h6>
                                <p>1. URL de devolución de llamada (Callback URL): <code>https://SU_DOMINIO/whatsapp/webhook</code></p>
                                <p>2. Token de verificación: Ingrese el valor exacto configurado en el campo <strong>Webhook Verify Token</strong>.</p>
                                <p>3. En los campos de suscripción de Webhook, suscriba los eventos: <code>messages</code>.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_whatsapp_account" model="ir.actions.act_window">
        <field name="name">Cuentas de WhatsApp</field>
        <field name="res_model">whatsapp.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree su primera cuenta de WhatsApp Cloud API vinculada a Meta.
            </p>
        </field>
    </record>
</odoo>
