<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Rule for whatsapp.account -->
        <record id="whatsapp_account_comp_rule" model="ir.rule">
            <field name="name">WhatsApp Account multi-company</field>
            <field name="model_id" ref="model_whatsapp_account"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-Company Rule for whatsapp.template -->
        <record id="whatsapp_template_comp_rule" model="ir.rule">
            <field name="name">WhatsApp Template multi-company</field>
            <field name="model_id" ref="model_whatsapp_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-Company Rule for whatsapp.message -->
        <record id="whatsapp_message_comp_rule" model="ir.rule">
            <field name="name">WhatsApp Message multi-company</field>
            <field name="model_id" ref="model_whatsapp_message"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
